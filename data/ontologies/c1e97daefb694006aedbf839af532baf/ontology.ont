            "position_x": 1496.7187500000005,
            "position_y": 665.71875
        },
        {
            "attributes": {
                "Категория": "Алгоритм",
                "Определение": "Это алгоритм обучения модели, который в обратном направлении (от выхода ко входу) распространяет вычисленную ошибку, чтобы на основе градиентов обновить веса модели и минимизировать её погрешность."
            },
            "id": "47",
            "name": "Обратное распространение",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 1879.5,
            "position_y": 794.0208333333335
        },
        {
            "attributes": {
                "Категория": "Модель",
                "Определение": "это модель глубокого обучения, использующая свёртки для анализа данных."
            },
