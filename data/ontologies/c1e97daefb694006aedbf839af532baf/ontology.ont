    "nodes": [
        {
            "attributes": {
                "Категория": "Технология",
                "Определение": "Это технология (или совокупность технологий), позволяющая создавать системы, способные выполнять задачи, требующие человеческого интеллекта (распознавание, принятие решений, генерация)."
            },
            "id": "1",
            "name": "Искусственный интеллект",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 977.5625000000002,
            "position_y": 312.8125000000001
        },
        {
            "attributes": {
                "Категория": "Технология",
                "Определение": "Это технология в рамках искусственного интеллекта, предоставляющая системам способность автоматически обучаться и улучшать свою производительность на основе опыта (данных), без явного программирования."
            },
            "id": "2",
            "name": "Машинное обучение",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 897.4375000000001,
            "position_y": 396.7500000000001
        },
        {
            "attributes": {
                "Категория": "Технология",
                "Определение": "Это подмножество машинного обучения, использующее глубокие нейронные сети (10+ слоев) со сложными архитектурами, способные к автоматическому извлечению иерархических признаков из сырых данных и решению сложных задач."
            },
            "id": "4",
            "name": "Глубинное машинное обучение",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 1056.7604166666663,
            "position_y": 433.46875000000006
        },
        {
            "attributes": {
                "Категория": "Модель",
                "Определение": "Это вычислительная модель, использующая процесс обучения, построенная на основе глубокой нейронной сети с множеством слоев, где каждый уровень иерархически преобразует входные данные, выделяя все более сложные признаки."
            },
            "id": "9",
            "name": "Модель глубокого обучения",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 780.1875000000001,
            "position_y": 468.76041666666686
        },
        {
            "attributes": {
                "Категория": "Модель",
                "Определение": "Это модель глубокого обучения, основанная исключительно на механизме самовнимания (без сверточных или рекуррентных слоев) и предназначенная для обработки последовательностей данных."
            },
            "id": "18",
            "name": "Модель трансформер",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 707.4062499999997,
            "position_y": 600.6875000000002
        },
        {
            "attributes": {
                "Категория": "Метод",
                "Определение": "Это вычислительный метод, архитектуры трансформера, который анализирует взаимосвязи между всеми элементами последовательности, вычисляя веса значимости для каждого элемента относительно других."
            },
            "id": "20",
            "name": "Механизм внимания",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 779.25,
            "position_y": 925.0625
        },
        {
            "attributes": {
                "Категория": "Модель",
                "Определение": "Это компонент архитектуры модели трансформера, преобразующий входные данные в внутреннее представление."
            },
            "id": "24",
            "name": "Энкодер",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 1051.3333333333335,
            "position_y": 920.5625
        },
        {
            "attributes": {
                "Категория": "Модель",
                "Определение": "это компонент архитектуры модели трансформера, генерирующий выходные данные на основе внутреннего представления."
            },
            "id": "27",
            "name": "Декодер",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 1157,
            "position_y": 917.8125
        },
        {
            "attributes": {
                "Категория": "Ресурс",
                "Определение": "Это ресурс программной реализации модели трансформер, представляющий собой числовые векторные представления токенов входного текста, которые используются на начальном этапе обработки данных для преобразования текстовых символов в формат, понятный модели."
            },
            "id": "29",
            "name": "Входные эмбеддинги",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 401.25,
            "position_y": 998.3125
        },
        {
            "attributes": {
                "Категория": "Метод",
                "Определение": "Это метод добавления информации о позиции токенов в последовательности, позволяющий модели учитывать порядок слов при обработке входных данных."
            },
            "id": "31",
            "name": "Позиционное кодирование",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 101,
            "position_y": 939.0625
        },
        {
            "attributes": {
                "Категория": "Метод",
                "Определение": "Это метод механизма внимания с несколькими параллельными головами."
            },
            "id": "33",
            "name": "Мультиголовное внимание",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 784.25,
            "position_y": 988.0625
        },
        {
            "attributes": {
                "Категория": "Модель",
                "Определение": "Это модель полносвязного слоя трансформера, представляющая собой слой, применяемый после механизма внимания, которая независимо обрабатывает каждый элемент последовательности."
            },
            "id": "35",
            "name": "Feed-forward слой",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 1282.5,
            "position_y": 1031.5625
        },
        {
            "attributes": {
                "Категория": "Задача",
                "Определение": "Это итеративная задача настройки параметров модели на основе обучающих данных, которая начинается с инициализации весов и циклически повторяет этапы прямого распространения для получения прогноза, вычисления ошибки и обратного распространения для обновления параметров с целью минимизации функции потерь и повышения точности предсказаний."
            },
            "id": "41",
            "name": "Процесс обучения",
            "namespace": "http://knova.ru/user/1762090972529",
            "position_x": 1624.427083333333,
            "position_y": 524.760416666667
        },
        {
            "attributes": {
                "Категория": "Метод",
                "Определение": "Это метод процесса обучения, измеряющий разницу между предсказаниями модели и правильными ответами."
            },
            "id": "43",
            "name": "Функция потерь",
