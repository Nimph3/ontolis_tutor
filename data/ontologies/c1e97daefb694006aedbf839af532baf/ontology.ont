            "position_x": 1375.3055555555557,
            "position_y": 676.1145833333334
        },
        {
            "attributes": {
                "Категория": "Метод",
                "Определение": "Это метод процесса обучения, обновляющий параметры модели на основе градиента функции потерь."
            },
