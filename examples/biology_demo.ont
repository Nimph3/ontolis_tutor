{
  "nodes": [
    {
      "id": "01_cell",
      "name": "Клетка",
      "attributes": {
        "def": "Клетка — структурная и функциональная единица живых организмов. Её основные компоненты обеспечивают обмен веществ, сохранение наследственной информации и жизнедеятельность."
      }
    },
    {
      "id": "02_organelles",
      "name": "Органоиды",
      "attributes": {
        "def": "Органоиды — специализированные внутриклеточные структуры, выполняющие определённые функции."
      }
    },
    {
      "id": "03_nucleus",
      "name": "Ядро",
      "attributes": {
        "def": "Ядро — мембранный органоид эукариотической клетки, в котором находится большая часть её генетического материала."
      }
    },
    {
      "id": "04_mitochondria",
      "name": "Митохондрия",
      "attributes": {
        "def": "Митохондрия — органоид эукариотической клетки, участвующий в клеточном дыхании и синтезе АТФ."
      }
    },
    {
      "id": "05_ribosome",
      "name": "Рибосома",
      "attributes": {
        "def": "Рибосома — немембранная клеточная структура, обеспечивающая синтез белков."
      }
    },
    {
      "id": "06_membrane",
      "name": "Клеточная мембрана",
      "attributes": {
        "def": "Клеточная мембрана — оболочка, отделяющая содержимое клетки от внешней среды и регулирующая транспорт веществ."
      }
    },
    {
      "id": "07_cytoplasm",
      "name": "Цитоплазма",
      "attributes": {
        "def": "Цитоплазма — внутренняя среда клетки, включающая цитозоль и расположенные в нём клеточные структуры."
      }
    }
  ],
